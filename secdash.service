[Unit]
Description=SecDash honeypot analytics
After=network.target

[Service]
Type=simple
User=secdash
WorkingDirectory=/opt/secdash/backend
ExecStart=/opt/secdash/backend/bin/server
Restart=always
RestartSec=5
# MONGO_URI=..., optional DASH_TOKEN=..., GEMINI_API_KEY=... go in this file (chmod 600)
EnvironmentFile=/etc/secdash.env
Environment=PORT=8080
Environment=STATIC_DIR=/opt/secdash/frontend/dist

[Install]
WantedBy=multi-user.target
