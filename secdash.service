[Unit]
Description=SecDash Honeypot Threat Operations Center (Golang Backend & PWA)
After=network.target

[Service]
Type=simple
User=marcos_007
WorkingDirectory=/home/marcos_007/Documents/project/sec_dash
ExecStart=/home/marcos_007/Documents/project/sec_dash/backend/bin/server
Restart=always
RestartSec=5
Environment=PORT=8080
Environment=DB_PATH=/home/marcos_007/Documents/project/sec_dash/backend/data/secdash.db
Environment=STATIC_DIR=/home/marcos_007/Documents/project/sec_dash/frontend/dist

[Install]
WantedBy=multi-user.target
